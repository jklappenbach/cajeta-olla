node_modules/
dist/
.wrangler/
.dev.vars
*.log
.DS_Store

# UI build output / deps
ui/node_modules/
ui/dist/
ui/.vite/

# local scratch
/tmp-*

# signing keys / secrets — never commit (set prod keys via `wrangler secret put`)
*.key
*.pem

# Compiler cache — bitcode and prebuilt archives, regenerated on every build.
# Never source. Committed cache also risks feeding a stale artifact to a
# different toolchain than the one that produced it.
**/.cajeta/cache/

# Build output. Prophylactic: this is not a cajeta build project today, but
# the ecosystem convention is that everything generated lives under build/
# and nothing generated is ever committed.
build/
**/.cajeta/cache/

# Credentials. NEVER committed — this repository is public.
#
# Added after two token files were swept into history by a `git add -A`:
# a revoked admin token and a LIVE publish token, both pushed. The rule is
# a pattern rather than two names so the next one is caught by shape.
*token*.txt
*.token
olla-admin-token*
olla-publish-token*
