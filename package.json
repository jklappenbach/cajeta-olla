{
  "name": "cajeta-olla",
  "version": "0.1.0",
  "private": true,
  "description": "Olla \u2014 the package registry for the Cajeta programming language (olla.cajeta.dev)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply olla-catalog --local",
    "migrate:remote": "wrangler d1 migrations apply olla-catalog --remote",
    "seed:local": "node scripts/seed.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.conformance.json",
    "test": "vitest run",
    "test:conformance": "vitest run --config vitest.conformance.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "hono": "^4.5.8"
  }
}
